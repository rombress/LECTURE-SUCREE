# =============================================================================
# Lecture sucrée — modèle de variables d'environnement.
#
# Ce fichier est PUBLIC et ne contient AUCUNE valeur réelle.
# Copiez-le en `.env` (ignoré par Git) UNIQUEMENT si une étape l'exige.
# Aucune variable n'est nécessaire pour le lot 0.
# =============================================================================

# --- Signature Android release (compilation LOCALE uniquement) ---------------
# En CI, ces valeurs viennent des secrets GitHub Actions, jamais d'un fichier.
# Le keystore doit être stocké HORS du dossier du projet.
LS_ANDROID_KEYSTORE_PATH=
LS_ANDROID_KEYSTORE_PASSWORD=
LS_ANDROID_KEY_ALIAS=
LS_ANDROID_KEY_PASSWORD=

# --- Google Drive (lot futur, NON utilisé pour l'instant) ---------------------
# Identifiants client OAuth "application installée" (iOS / Android). Ce ne sont
# pas des secrets au sens strict, mais ils sont liés à votre compte Google :
# ils restent hors du dépôt public.
# LS_GOOGLE_IOS_CLIENT_ID=
# LS_GOOGLE_ANDROID_CLIENT_ID=
