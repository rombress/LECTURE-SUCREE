{
  "name": "lecture-sucree",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "privacy:staged": "node scripts/privacy-check.mjs --staged",
    "privacy:tracked": "node scripts/privacy-check.mjs --tracked",
    "privacy:history": "node scripts/privacy-check.mjs --history",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:unit && npm run test:node",
    "test:unit": "jest",
    "test:node": "node --test --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/node/*.test.mjs\"",
    "doctor": "npx --yes expo-doctor@1.21.6",
    "verify": "npm run privacy:tracked && npm run typecheck && npm run lint && npm run test",
    "bundle:check": "expo export --platform ios --output-dir build/export-check",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "prebuild:ios": "expo prebuild --platform ios --clean --no-install",
    "postinstall": "node scripts/patch-speech-recognition.mjs"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-speech-recognition": "~58.0.1",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "~24.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "~16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3"
  }
}
